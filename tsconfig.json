{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": [
			"DOM",
			"ESNext"
		],
		"allowJs": true,
		"checkJs": false,
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "Node",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"ignoreDeprecations": "6.0",
		"typeRoots": [
			"./src/admin/types",
			"./node_modules/@types"
		],
		"types": [
			"node",
			"react",
			"react-dom"
		]
	},
	"include": [
		"src/**/*",
		"src/admin/types/**/*"
	],

	"exclude": [
		"node_modules",
		"build",
		"dist"
	]
}